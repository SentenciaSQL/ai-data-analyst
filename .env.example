# Copy to .env for local overrides. Defaults in compose.yaml are for development only.
# Do not use development values in production.

ADA_ENV=local

POSTGRES_USER=ada
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=ai_data_analyst
APP_DB_PASSWORD=dev-only-change-me

JWT_SECRET=dev-only-jwt-secret-change-me-32b
JWT_ISSUER=ai-data-analyst
INTERNAL_API_KEY=dev-only-internal-key

# openai or anthropic. Leave keys empty to run without calling a provider.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GRAFANA_ADMIN_PASSWORD=dev-only-change-me

# Optional PrimeNG community or commercial key. Used when the frontend image is built.
PRIMENG_LICENSE=
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
